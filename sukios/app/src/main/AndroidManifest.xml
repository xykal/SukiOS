<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      QUERY_ALL_PACKAGES
      Google Play mengizinkan permission ini untuk LAUNCHER (PRD 8). SukiOS
      memang launcher: butuh daftar aplikasi terpasang untuk desktop, start
      menu, dan pencarian. Alternatif hemat izin (blok <queries>) tetap dipasang.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Taskbar melayang di atas app lain (opsional, diminta lewat UI Setup) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Untuk panel pintasan: cermin status bar (baterai, jam) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Agar aksi "hapus aplikasi" bisa memakai dialog sistem -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Ikon Wi-Fi di tray: hanya membaca status jaringan (izin normal, tanpa dialog) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Izin ini tidak bisa diminta lewat dialog: hanya bisa diberikan lewat `pm grant` dari Shizuku
      (SetupPlan, langkah "secure"). Dengannya SukiOS bisa menjaga setelan jendela tetap menyala
      tanpa bergantung pada Shizuku setiap saat. Lint menandainya "protected"; itu disengaja.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Cara Play-friendly untuk melihat app yang punya launcher -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Agar aplikasi Shizuku bisa dideteksi/dibuka dari panel Akses Lanjutan -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".SukiApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SukiTheme">

        <!--
          Beranda SukiOS — sekaligus launcher (HOME + DEFAULT).
          configChanges dipasang supaya shell tidak pernah di-recreate saat
          orientasi/ukuran berubah: jendela yang sedang terbuka harus selamat.
        -->
        <activity
            android:name=".SukiHomeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode|layoutDirection|fontScale|locale|touchscreen|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Jendela uji milik SukiOS: dibuka SukiAuto sebagai jendela mengambang untuk membuktikan bahwa
          mode jendela benar-benar bekerja, lalu menutup dirinya. Diekspor agar `am start` dari shell
          selalu bisa memanggilnya; ia tidak menerima data apa pun.
        -->
        <activity
            android:name=".ProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="" />

        <!-- Taskbar melayang; hidup hanya kalau pengguna menyalakannya -->
        <service
            android:name=".SukiOverlayBar"
            android:exported="false" />

        <!--
          Provider Shizuku — wajib ada agar binder Shizuku bisa diserahkan ke app ini.
          Nama kelas, authority, dan permission mengikuti dokumentasi resmi Shizuku API.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
